# NODE / HTTP
# LIVEZONE_HTTP_HOST: OPTIONAL; development default 0.0.0.0.
# Production behind a same-host reverse proxy: 127.0.0.1.
LIVEZONE_HTTP_HOST=0.0.0.0
# PORT: OPTIONAL; development default 8080; valid range 1-65535.
PORT=8080

# OPERATOR AUTHENTICATION
# Authentication is enabled by default and fails closed without a username and
# exactly one password setting. Never reuse LIVEZONE_PROGRAM_OUTPUT_TOKEN.
LIVEZONE_OPERATOR_USERNAME=replace-with-operator-username
# Local development may use a plaintext environment secret. Prefer the scrypt
# verifier below for production and leave this empty when a verifier is used.
LIVEZONE_OPERATOR_PASSWORD=replace-with-operator-password
# Preferred production verifier format:
# scrypt$16384$8$1$<base64url-16+-byte-salt>$<base64url-64-byte-digest>
LIVEZONE_OPERATOR_PASSWORD_SCRYPT=
# 300-86400 seconds; default 28800 (8 hours).
LIVEZONE_OPERATOR_SESSION_TTL_SECONDS=28800
# Defaults true. Set false explicitly only for localhost HTTP development.
LIVEZONE_OPERATOR_COOKIE_SECURE=false
# Optional exact comma-separated origins. Production: https://www.livezone.it
LIVEZONE_OPERATOR_ALLOWED_ORIGINS=
# Development-only bypass. Default false. Never enable on a shared/public bind.
LIVEZONE_OPERATOR_AUTH_DISABLED=false

# PROGRAM OUTPUT
# REQUIRED for Node startup; secret; minimum 16 characters. Use a unique value.
LIVEZONE_PROGRAM_OUTPUT_TOKEN=replace-with-a-long-random-secret

# ORIGIN / CORS
# OPTIONAL; development default empty. Comma-separated exact trusted Control origins.
# Production recommendation: keep Control/Public same-origin; otherwise use HTTPS origins.
LIVEZONE_ALLOWED_ORIGINS=

# MEDIA LIBRARY
# OPTIONAL; default is var/media-library under the repository. Use an absolute,
# writable, backed-up production data directory outside immutable release files.
LIVEZONE_MEDIA_LIBRARY_ROOT=
# OPTIONAL; development default 2147483648 bytes (2 GiB). Positive byte count.
LIVEZONE_MEDIA_LIBRARY_MAX_BYTES=2147483648

# MEDIA INGEST / MEDIAMTX (consumed by Node)
# All are OPTIONAL and have the displayed local-development defaults.
LIVEZONE_MEDIA_INGEST_ID=local-main
LIVEZONE_MEDIA_INGEST_NAME=Local Main
LIVEZONE_MEDIA_INGEST_PATH=livezone-test
# Must be a credential-free HTTP(S) loopback origin.
LIVEZONE_MEDIA_INGEST_API_ORIGIN=http://127.0.0.1:9997
# Browser-visible, credential-free HLS URL whose path matches MEDIA_INGEST_PATH.
# Production recommendation: use the viewer-reachable HTTPS reverse-proxy URL.
LIVEZONE_MEDIA_INGEST_HLS_URL=http://127.0.0.1:8888/livezone-test/index.m3u8

# RTMP PUBLISHING (consumed only by tools/start-mediamtx.ps1)
# Both are REQUIRED by that tool; secrets; no development defaults.
LIVEZONE_RTMP_PUBLISH_USER=replace-with-a-long-random-publisher-user
LIVEZONE_RTMP_PUBLISH_PASSWORD=replace-with-a-long-random-publisher-password
